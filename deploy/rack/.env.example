## Required env for the rack-side stack. Copy to .env and fill in real values.
## NEVER commit a populated .env.

## --- Postgres ---
POSTGRES_PASSWORD=change-me

## --- App secrets ---
JWE_SECRET=change-me-32-bytes-base64
ENCRYPTION_KEY=change-me-32-bytes-base64

## --- GitHub App (created on github.com/settings/apps) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

## --- Provider keys ---
OPENCODE_GO_API_KEY=
ANTHROPIC_API_KEY=

## --- Pi config (mounted into container at /data/pi) ---
PI_AUTH_PATH=/data/pi/auth.json
PI_MODELS_PATH=/data/pi/models.json

## --- Sandbox ---
SANDBOX_BASE_IMAGE=open-agents-sandbox:base
## Hostname the agent should put in dev-server preview URLs. Browsers on the
## rack LAN can use rack.local; from-anywhere previews require the v2
## per-port Cloudflare tunnel work (out of scope for v1).
SANDBOX_PUBLIC_HOST=localhost
## Override only if Docker socket is non-default (e.g. rootless docker).
# SANDBOX_DOCKER_HOST=unix:///run/user/1000/docker.sock

## --- Cloudflare Tunnel ---
## Token from `cloudflared tunnel token <tunnel-name>`.
CLOUDFLARE_TUNNEL_TOKEN=

## --- Agent backend ---
## Set to "pi" to use the pi-coding-agent runner; "tool-loop" keeps the legacy
## ToolLoopAgent path (requires AI SDK keys, not the rack default).
AGENT_BACKEND=pi
